rules_version = '2';
// ─────────────────────────────────────────────────────────────
// Phân quyền CCM (phương án A1)
//   admin   : toàn quyền, cấp quyền cho người khác
//   user    : QS — xem và sửa dữ liệu dự án
//   manager : chỉ xem
//   pending : tài khoản mới, chờ admin cấp quyền → không thấy dữ liệu
// Không ai tự sửa được trường `role` của chính mình.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin()  { return signedIn() && hasProfile() && myRole() == 'admin'; }
    function canEdit()  { return signedIn() && hasProfile() && myRole() in ['admin', 'user']; }
    function canRead()  { return signedIn() && hasProfile() && myRole() in ['admin', 'user', 'manager']; }

    // ── Hồ sơ người dùng ──
    match /users/{userId} {
      // Đọc: chính mình, hoặc admin
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // Tạo lần đầu: chỉ cho chính mình, bắt buộc role = 'pending'
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'pending';

      // Sửa: admin sửa tất cả; người dùng chỉ sửa thông tin cá nhân, KHÔNG đổi role
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // ── Dữ liệu dự án ──
    match /projects/{projectId} {
      allow read: if canRead();
      allow create, update: if canEdit();
      allow delete: if isAdmin();
    }

    // ── Mặc định: từ chối mọi thứ khác ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
